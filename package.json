{
  "name": "@vibeharness/cli",
  "version": "0.8.4",
  "description": "Production harness for vibecoding — PRD, spec, curated stack recommendations, AI rules, context packing and audits in a single CLI",
  "type": "module",
  "bin": {
    "vibe-harness": "./dist/cli.js"
  },
  "files": [
    "dist",
    "registry"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "ts-node --esm src/cli.ts",
    "lint": "eslint .",
    "knip": "knip",
    "test": "node --experimental-vm-modules node_modules/.bin/jest --passWithNoTests",
    "registry:sync": "node scripts/registry-sync.mjs",
    "docs:tools": "node scripts/gen-tools-doc.mjs",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "vibecoding",
    "ai",
    "cli",
    "harness",
    "audit",
    "security",
    "cursor",
    "claude",
    "copilot"
  ],
  "author": "VibeHarness Contributors",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/EuVinicios/vibeHarness.git"
  },
  "bugs": {
    "url": "https://github.com/EuVinicios/vibeHarness/issues"
  },
  "homepage": "https://github.com/EuVinicios/vibeHarness#readme",
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "chalk": "^6.0.0",
    "commander": "^15.0.0",
    "enquirer": "^2.4.1",
    "fast-glob": "^3.3.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.2.0",
    "eslint": "^10.8.1",
    "globals": "^17.11.0",
    "jest": "^30.4.2",
    "knip": "^6.32.2",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "knip": {
    "ignoreExportsUsedInFile": true,
    "ignore": [
      "site/**"
    ]
  },
  "jest": {
    "preset": "ts-jest/presets/default-esm",
    "testEnvironment": "node",
    "testMatch": [
      "**/tests/**/*.test.ts"
    ],
    "extensionsToTreatAsEsm": [
      ".ts"
    ],
    "moduleNameMapper": {
      "^(\\.{1,2}/.*)\\.js$": "$1"
    },
    "transform": {
      "^.+\\.tsx?$": [
        "ts-jest",
        {
          "useESM": true,
          "diagnostics": {
            "ignoreCodes": [
              151002
            ]
          }
        }
      ]
    }
  }
}
