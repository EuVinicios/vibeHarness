{
  "$comment": "AI client adapters for `vibe-harness install`. Adding a client = adding an entry here (no src/ changes). MCP config formats: mcp-servers (Claude Code/Cursor/Windsurf/Qwen shape), vscode-servers (VS Code 'servers' shape), opencode (local command array). status: stable = verified, beta = best-effort, verify in the client UI.",
  "serverName": "vibe-harness",
  "serverCommand": { "command": "npx", "args": ["-y", "@vibeharness/cli", "mcp"] },
  "clients": [
    {
      "id": "claude-code",
      "name": "Claude Code",
      "status": "stable",
      "detect": [".claude/**", "CLAUDE.md"],
      "rules": { "path": "CLAUDE.md", "format": "claude-md" },
      "mcp": { "path": ".mcp.json", "format": "mcp-servers", "global": false },
      "extras": [
        { "path": ".claude/skills/vibeharness/SKILL.md", "template": "skill" },
        { "path": ".claude/commands/{command}.md", "template": "command", "foreach": ["start", "prd", "plan", "pack", "audit", "doctor", "status", "install"] }
      ],
      "docs": "https://code.claude.com/docs/en/mcp"
    },
    {
      "id": "cursor",
      "name": "Cursor",
      "status": "stable",
      "detect": [".cursor/**", ".cursorrules"],
      "rules": { "path": ".cursor/rules/vibeharness.mdc", "format": "cursor-mdc" },
      "mcp": { "path": ".cursor/mcp.json", "format": "mcp-servers", "global": false },
      "extras": [],
      "docs": "https://docs.cursor.com/advanced/mcp"
    },
    {
      "id": "opencode",
      "name": "opencode",
      "status": "stable",
      "detect": ["opencode.json", "opencode.jsonc", "AGENTS.md"],
      "rules": { "path": "AGENTS.md", "format": "agents-md" },
      "mcp": { "path": "opencode.json", "format": "opencode", "global": false },
      "extras": [],
      "docs": "https://opencode.ai/docs/mcp"
    },
    {
      "id": "vscode-copilot",
      "name": "VS Code Copilot",
      "status": "stable",
      "detect": [".vscode/**", ".github/copilot-instructions.md"],
      "rules": { "path": ".github/copilot-instructions.md", "format": "copilot-md" },
      "mcp": { "path": ".vscode/mcp.json", "format": "vscode-servers", "global": false },
      "extras": [],
      "docs": "https://code.visualstudio.com/docs/copilot/customization/mcp-servers"
    },
    {
      "id": "windsurf",
      "name": "Windsurf",
      "status": "stable",
      "detect": [".windsurfrules"],
      "rules": { "path": ".windsurfrules", "format": "windsurf-md" },
      "mcp": { "path": "~/.codeium/windsurf/mcp_config.json", "format": "mcp-servers", "global": true },
      "extras": [],
      "docs": "https://docs.windsurf.com/windsurf/cascade/mcp"
    },
    {
      "id": "antigravity",
      "name": "Antigravity",
      "status": "beta",
      "detect": [".antigravity/**"],
      "rules": { "path": "AGENTS.md", "format": "agents-md" },
      "mcp": { "path": ".mcp.json", "format": "mcp-servers", "global": false },
      "extras": [],
      "docs": "https://antigravity.google docs — MCP section"
    },
    {
      "id": "qwen",
      "name": "Qwen Code",
      "status": "beta",
      "detect": [".qwen/**"],
      "rules": { "path": "AGENTS.md", "format": "agents-md" },
      "mcp": { "path": ".qwen/settings.json", "format": "mcp-servers", "global": false },
      "extras": [],
      "docs": "https://github.com/QwenLM/qwen-code"
    }
  ]
}
